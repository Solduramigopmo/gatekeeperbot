# ─── Telegram ──────────────────────────────────────────────────────────────────
# Get the token from @BotFather.
BOT_TOKEN=123456:replace-me

# Numeric ID of the channel the bot will guard. The bot MUST be added there
# as administrator with the "Invite users via link" permission.
CHANNEL_ID=-1001234567890

# Comma-separated list of Telegram user IDs allowed to open the admin panel.
ADMIN_IDS=111111111,222222222

# Optional public @username of the channel (used in messages only).
CHANNEL_USERNAME=

# ─── CryptoBot (Crypto Pay) ────────────────────────────────────────────────────
# Token from @CryptoBot → Crypto Pay → My Apps.
CRYPTO_PAY_TOKEN=replace-me
# Use "https://pay.crypt.bot" for mainnet or "https://testnet-pay.crypt.bot"
# for the testnet environment.
CRYPTO_PAY_BASE_URL=https://pay.crypt.bot
# Currencies offered to the buyer. Crypto Pay supports USDT, TON, BTC, ETH, etc.
CRYPTO_PAY_ASSETS=USDT,TON

# ─── Webhook (optional but strongly recommended in production) ─────────────────
# If WEBHOOK_ENABLED=true, the bot starts an aiohttp server that accepts
# Crypto Pay webhooks at WEBHOOK_PATH. Otherwise payments are reconciled by
# polling Crypto Pay every POLL_INTERVAL_SECONDS seconds.
WEBHOOK_ENABLED=false
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/cryptopay
POLL_INTERVAL_SECONDS=60

# ─── Subscription plans ────────────────────────────────────────────────────────
# JSON list of plans. "price" is in the asset chosen by the user at checkout.
# "id" must be unique and stable — it is stored alongside every payment.
SUBSCRIPTION_PLANS=[
  {"id":"1m","title":"1 месяц","days":30,"price":"5.00"},
  {"id":"3m","title":"3 месяца","days":90,"price":"13.00"},
  {"id":"6m","title":"6 месяцев","days":180,"price":"24.00"},
  {"id":"12m","title":"12 месяцев","days":365,"price":"42.00"}
]

# How many days before expiry to remind the user. Comma-separated.
REMINDER_DAYS=3,1

# ─── Branding ──────────────────────────────────────────────────────────────────
# Path to the welcome image shown with /start. Leave empty to skip the photo.
WELCOME_IMAGE=assets/welcome.jpg
SUPPORT_URL=https://t.me/your_support
INFO_URL=

# ─── Storage ───────────────────────────────────────────────────────────────────
# SQLite by default. For PostgreSQL use:
#   postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/bot.sqlite3

# ─── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Anti-abuse: max number of buy attempts per minute per user.
THROTTLE_BUY_PER_MINUTE=5
